# Server only. Never prefix any of these with NEXT_PUBLIC_.

# Supabase: the waitlist.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# The app (FastAPI on Cloud Run). Served to the browser as /app on this
# domain; this is the origin the rewrite and the server-side calls point at.
APP_ORIGIN=https://oyesun-rebuild-bj3tjaelqq-as.a.run.app

# Shared with the app, as WAITLIST_BRIDGE_SECRET there. It is what lets this
# site create an account without an invite code, so it is the one secret that
# must match on both sides. Generate with: openssl rand -hex 32
WAITLIST_BRIDGE_SECRET=

# Guards /admin and the approval endpoints. Anything long and random.
ADMIN_TOKEN=
